---
// Arte pixelado original dibujado en SVG.
// Determinista: la misma ciudad en cada build.

let seed = 1337;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

const buildings = [
  { x: -30, w: 230, top: 150, color: '#151a1d', roof: 'flat', fire: true },
  { x: 180, w: 150, top: 86, color: '#1a2024', roof: 'peak' },
  { x: 320, w: 120, top: 210, color: '#20272b', roof: 'flat' },
  { x: 432, w: 128, top: 300, color: '#161b1e', roof: 'peak' },
  { x: 1072, w: 128, top: 300, color: '#161b1e', roof: 'peak' },
  { x: 1188, w: 120, top: 210, color: '#20272b', roof: 'flat' },
  { x: 1300, w: 150, top: 86, color: '#1a2024', roof: 'peak' },
  { x: 1440, w: 230, top: 150, color: '#151a1d', roof: 'flat', fire: true },
];

const litColors = ['#e0a75e', '#e0a75e', '#d94336', '#c98a4b', '#5e8a84', '#8f5a3a'];

type Win = { x: number; y: number; w: number; h: number; color: string; dim: boolean };

const windows: Win[] = [];
buildings.forEach((b) => {
  const stepY = 50;
  const stepX = 34;
  for (let y = b.top + 48; y < 876; y += stepY) {
    for (let x = b.x + 18; x < b.x + b.w - 22; x += stepX) {
      const lit = rnd() > 0.47;
      const color = lit
        ? litColors[Math.floor(rnd() * litColors.length)]
        : '#0c1012';
      windows.push({
        x,
        y,
        w: 14,
        h: 19,
        color,
        dim: !lit,
      });
    }
  }
});

const distant = Array.from({ length: 22 }, (_, i) => ({
  x: 520 + i * 30,
  w: 22 + Math.floor(rnd() * 22),
  top: 470 - Math.floor(rnd() * 140),
}));

const embers = Array.from({ length: 34 }, () => ({
  x: Math.floor(rnd() * 1600),
  y: 120 + Math.floor(rnd() * 600),
  s: rnd() > 0.8 ? 3 : 2,
  c: rnd() > 0.55 ? '#d94336' : '#e0a75e',
  o: (0.25 + rnd() * 0.5).toFixed(2),
}));

const fencePosts = [0, 200, 400, 600, 800, 1000, 1200, 1400, 1600];
---

<svg
  viewBox="0 0 1600 900"
  preserveAspectRatio="xMidYMid slice"
  class="w-full h-full"
  role="img"
  aria-label="Ilustración pixelada de una ciudad distópica bajo un sol rojo, con vallas y cables eléctricos"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#170c0c" />
      <stop offset="42%" stop-color="#4a1714" />
      <stop offset="72%" stop-color="#8c2a20" />
      <stop offset="100%" stop-color="#3a1311" />
    </linearGradient>
    <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ff6a52" stop-opacity="0.55" />
      <stop offset="55%" stop-color="#d94336" stop-opacity="0.22" />
      <stop offset="100%" stop-color="#d94336" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="sunFace" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#e8564a" />
      <stop offset="100%" stop-color="#b52c24" />
    </linearGradient>
    <linearGradient id="haze" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#d94336" stop-opacity="0" />
      <stop offset="100%" stop-color="#d94336" stop-opacity="0.14" />
    </linearGradient>
    <pattern id="fence" width="56" height="56" patternUnits="userSpaceOnUse">
      <path d="M0 0 L56 56 M56 0 L0 56" stroke="#090b0c" stroke-width="2.5" opacity="0.78" />
      <path d="M0 0 L56 56 M56 0 L0 56" stroke="#e0392f" stroke-width="0.7" opacity="0.1" />
    </pattern>
    <pattern id="bricks" width="28" height="14" patternUnits="userSpaceOnUse">
      <path d="M0 0 H28 M0 7 H28" stroke="#ffffff" stroke-width="1" opacity="0.025" />
      <path d="M14 0 V7 M0 7 V14" stroke="#ffffff" stroke-width="1" opacity="0.018" />
    </pattern>
  </defs>

  <!-- Cielo -->
  <rect width="1600" height="900" fill="url(#sky)" />
  <rect y="430" width="1600" height="470" fill="url(#haze)" />

  <!-- Nubes bajas -->
  <g fill="#6d211a" opacity="0.55">
    <rect x="90" y="150" width="250" height="8" />
    <rect x="140" y="166" width="170" height="6" />
    <rect x="1180" y="120" width="280" height="9" />
    <rect x="1240" y="138" width="180" height="6" />
    <rect x="620" y="92" width="190" height="6" />
  </g>

  <!-- Sol rojo -->
  <circle cx="800" cy="318" r="330" fill="url(#sunGlow)" />
  <circle cx="800" cy="318" r="186" fill="url(#sunFace)" />
  <g fill="#8f211b" opacity="0.35">
    <rect x="614" y="300" width="372" height="5" />
    <rect x="620" y="330" width="360" height="4" />
    <rect x="646" y="362" width="308" height="4" />
  </g>

  <!-- Skyline lejana -->
  <g fill="#3d1715">
    {distant.map((d) => (
      <rect x={d.x} y={d.top} width={d.w} height={560 - d.top} />
    ))}
  </g>
  <g fill="#e0a75e" opacity="0.4">
    {distant.map((d, i) =>
      i % 3 === 0 ? <rect x={d.x + 5} y={d.top + 16} width="4" height="6" /> : null
    )}
  </g>

  <!-- Calle en perspectiva -->
  <polygon points="780,548 820,548 1050,900 550,900" fill="#101416" />
  <g stroke="#2c3336" stroke-width="2" opacity="0.5">
    <line x1="800" y1="560" x2="800" y2="900" stroke-dasharray="14 18" stroke="#8c6a3e" stroke-width="3" opacity="0.45" />
    <line x1="780" y1="548" x2="550" y2="900" />
    <line x1="820" y1="548" x2="1050" y2="900" />
    <line x1="790" y1="620" x2="680" y2="900" />
    <line x1="810" y1="620" x2="920" y2="900" />
  </g>

  <!-- Edificios -->
  {buildings.map((b) => (
    <g>
      {b.roof === 'peak' && (
        <>
          <polygon
            points={`${b.x},${b.top} ${b.x + b.w / 2},${b.top - 58} ${b.x + b.w},${b.top}`}
            fill={b.color}
          />
          <rect x={b.x + b.w / 2 - 10} y={b.top - 86} width="18" height="34" fill={b.color} />
        </>
      )}
      <rect x={b.x} y={b.top} width={b.w} height={900 - b.top} fill={b.color} />
      <rect x={b.x} y={b.top} width={b.w} height={900 - b.top} fill="url(#bricks)" />
      <rect x={b.x - 6} y={b.top - 10} width={b.w + 12} height="12" fill="#2b3337" opacity="0.85" />
      <rect x={b.x} y={b.top + 16} width={b.w} height="3" fill="#3a4448" opacity="0.5" />
      {b.fire && (
        <g stroke="#2c3538" stroke-width="2.5" fill="none" opacity="0.8">
          <rect x={b.x + 24} y={b.top + 120} width="70" height="300" />
          <line x1={b.x + 24} y1={b.top + 190} x2={b.x + 94} y2={b.top + 260} />
          <line x1={b.x + 94} y1={b.top + 190} x2={b.x + 24} y2={b.top + 260} />
          <line x1={b.x + 24} y1={b.top + 330} x2={b.x + 94} y2={b.top + 400} />
        </g>
      )}
    </g>
  ))}

  <!-- Ventanas -->
  <g>
    {windows.map((w) => (
      <g>
        <rect x={w.x} y={w.y} width={w.w} height={w.h} fill={w.color} opacity={w.dim ? 0.55 : 0.92} />
        {!w.dim && <rect x={w.x} y={w.y} width={w.w} height="3" fill="#ffd59a" opacity="0.45" />}
        <rect x={w.x - 2} y={w.y - 2} width={w.w + 4} height={w.h + 4} fill="none" stroke="#0a0d0e" stroke-width="2" />
      </g>
    ))}
  </g>

  <!-- Postes y cables -->
  <g stroke="#090b0c">
    <g stroke-width="4">
      <line x1="376" y1="120" x2="376" y2="900" />
      <line x1="1224" y1="104" x2="1224" y2="900" />
    </g>
    <g stroke-width="2">
      <line x1="336" y1="170" x2="416" y2="170" />
      <line x1="336" y1="196" x2="416" y2="196" />
      <line x1="1184" y1="154" x2="1264" y2="154" />
      <line x1="1184" y1="180" x2="1264" y2="180" />
    </g>
    <g stroke-width="2.4" fill="none" opacity="0.92">
      <path d="M-40 150 C 280 220, 520 120, 800 196 S 1320 140, 1640 220" />
      <path d="M-40 186 C 300 250, 540 158, 800 232 S 1330 178, 1640 258" />
      <path d="M-40 226 C 300 286, 560 200, 800 268 S 1340 218, 1640 296" />
      <path d="M-40 274 C 320 330, 560 250, 800 308 S 1360 262, 1640 338" />
      <path d="M-40 330 C 340 380, 580 302, 800 354 S 1380 312, 1640 386" />
    </g>
  </g>

  <!-- Silueta en la calle -->
  <g fill="#0a0c0d">
    <ellipse cx="1320" cy="882" rx="54" ry="8" opacity="0.6" />
    <path d="M1296 730 q24 -22 48 0 l16 130 h-22 l-8 -86 -4 86 h-28 l-6 -92 -12 92 h-22 z" />
    <path d="M1300 736 q20 -34 40 0 l6 12 -52 0 z" />
    <circle cx="1320" cy="716" r="18" />
  </g>

  <!-- Brasas -->
  <g>
    {embers.map((e) => (
      <rect x={e.x} y={e.y} width={e.s} height={e.s} fill={e.c} opacity={e.o} />
    ))}
  </g>

  <!-- Valla metálica -->
  <g>
    <rect width="1600" height="900" fill="url(#fence)" />
    <g stroke="#090b0c" stroke-width="5" opacity="0.85">
      {fencePosts.map((x) => (
        <line x1={x} y1="0" x2={x} y2="900" />
      ))}
    </g>
    <g stroke="#090b0c" stroke-width="6" opacity="0.9">
      <line x1="0" y1="92" x2="1600" y2="92" />
      <line x1="0" y1="760" x2="1600" y2="760" />
    </g>
  </g>

  <!-- Viñeta -->
  <rect width="1600" height="900" fill="url(#haze)" opacity="0.18" />
</svg>
