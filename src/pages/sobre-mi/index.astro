---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { sitio } from '../../../sitio.js';
import { withBase } from '../../utils/url';

const s = sitio.sobreMi;
const etiquetasRed: Record<string, string> = {
  instagram: 'Instagram',
  youtube: 'YouTube',
  x: 'X / Twitter',
  correo: 'Correo',
};
const redes = sitio.autor.redes.filter((r) => r.url);
---

<Layout title={`${s.titulo} — ${sitio.nombre}`}>
  <Header />

  <main class="flex-1">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <header class="border-b border-[var(--borde)] pb-8">
        <p class="u-kicker">// {s.etiqueta}</p>
        <h1 class="u-display mt-3 text-[clamp(3.2rem,10vw,7rem)] leading-[0.86]">
          {s.titulo.replace(sitio.autor.nombre, '')}
          <span class="text-[var(--rojo)]">{sitio.autor.nombre}</span>
        </h1>
        <p class="u-type mt-4 max-w-2xl text-sm leading-6 text-[var(--suave)]">
          {sitio.autor.rol}. Escribo desde {sitio.autor.ubicacion || 'algún lugar con mala conexión'}.
        </p>
      </header>

      <div class="mt-12 grid gap-12 md:grid-cols-[320px_1fr]">
        <!-- Polaroid + ficha -->
        <div>
          <div class="relative mx-auto w-[280px] rotate-[-2.5deg] border border-[var(--borde)] bg-[var(--tarjeta)] p-3 pb-14 shadow-[12px_12px_0_rgba(0,0,0,0.45)]">
            <span class="tape -top-3 left-10 -rotate-6"></span>
            <span class="tape -bottom-3 right-9 -rotate-3"></span>
            <img
              src={withBase(sitio.autor.avatar)}
              alt={sitio.autor.nombre}
              class="aspect-square w-full border border-[var(--borde)] object-cover"
            />
            <p class="u-type absolute bottom-4 left-0 right-0 text-center text-xs text-[var(--suave)]">{s.leyendaFoto}</p>
          </div>

          <div class="mt-10 border border-[var(--borde)] bg-[var(--tarjeta)] p-5">
            <p class="u-mono border-b border-dashed border-[var(--borde)] pb-2 text-[8px] font-bold uppercase tracking-[0.28em] text-[var(--rojo)]">
              Ficha rápida
            </p>
            <dl class="mt-4 space-y-3">
              {s.datos.map((dato) => (
                <div class="flex flex-col gap-0.5">
                  <dt class="u-mono text-[7px] uppercase tracking-[0.22em] text-[var(--suave)]">{dato.etiqueta}</dt>
                  <dd class="text-xs font-semibold text-[var(--texto)]">{dato.valor}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="mt-6 flex flex-wrap gap-2">
            {redes.map((red) => (
              <a
                href={red.url}
                class="u-mono border border-[var(--borde)] px-3 py-1.5 text-[8px] font-bold uppercase tracking-[0.18em] text-[var(--suave)] transition hover:border-[var(--rojo)] hover:text-[var(--rojo)]"
              >
                {etiquetasRed[red.icono] ?? red.nombre ?? red.icono}
              </a>
            ))}
          </div>
        </div>

        <!-- Historia -->
        <div>
          <div class="space-y-5">
            {s.parrafos.map((parrafo) => (
              <p class="u-type text-[15px] leading-7 text-[var(--crema)]/85">
                {parrafo}
              </p>
            ))}
          </div>

          <div class="mt-10">
            <p class="u-kicker">// {s.tituloIntereses}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {s.intereses.map((interes) => (
                <span class="u-mono border border-[var(--borde)] bg-[var(--tarjeta)] px-3 py-1.5 text-[8px] font-bold uppercase tracking-[0.18em] text-[var(--suave)]">
                  {interes}
                </span>
              ))}
            </div>
          </div>

          <blockquote class="mt-10 border-l-2 border-[var(--rojo)] pl-5">
            <p class="u-type text-lg leading-7 text-[var(--crema)]/90">
              «Escribo para entender mejor. Si algo de lo que lees te sirve, o crees que me equivoco, escríbeme.»
            </p>
          </blockquote>

          <div class="mt-10 flex flex-wrap gap-3">
            <a href={withBase('/articulos/')} class="btn-hard">Leer el archivo <span aria-hidden="true">→</span></a>
            <a href={withBase('/#newsletter')} class="btn-ghost">Suscribirme</a>
          </div>
        </div>
      </div>

      <!-- Manifiesto -->
      <section class="mt-20 border-y border-[var(--borde)] py-12">
        <div class="grid gap-8 md:grid-cols-3">
          {[
            { n: '01', t: 'Sin prisa', d: 'Publico cuando tengo algo que decir, no cuando el calendario lo exige.' },
            { n: '02', t: 'Sin humo', d: 'Nada de fórmulas mágicas ni rutinas imposibles. Errores incluidos.' },
            { n: '03', t: 'Sin algoritmo', d: 'El archivo se ordena por fechas y por temas. Tú eliges por dónde entrar.' },
          ].map((item) => (
            <div class="border-l border-[var(--borde)] pl-5">
              <span class="u-display text-4xl text-[var(--rojo)]">{item.n}</span>
              <h3 class="u-display mt-2 text-2xl">{item.t}</h3>
              <p class="mt-2 text-xs leading-5 text-[var(--suave)]">{item.d}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
